# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.next-stale-*/
/out-stale-*/

# local QA screenshots
/scripts/shots/

# 本地 Demo 素材输入目录（已拷贝到 public/demo/real-tryon）
/demo_simple/

# MediaPipe 运行时资源（由 scripts/fetch-mediapipe.ps1 生成）
/public/wasm/
/public/models/

# production
/build

# wrangler / Cloudflare Pages 本地缓存
/.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
